# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase → Project Settings → API).

# URL do projeto, ex.: https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública "anon"/"publishable" (pode ficar no navegador; o RLS protege os dados)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Endereço público do site (usado em links de compartilhamento e QR Codes)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chave secreta "service_role": usada SOMENTE pelo script que cria o
# primeiro administrador (npm run admin:create). Nunca coloque na Vercel.
SUPABASE_SERVICE_ROLE_KEY=
